from pygame import *

class GameSprite(sprite.Sprite):
    def __init__(self, player_image, player_x, player_y,
                player_speed, width, height):
        super().__init__()
        self.image = transform.scale(image.load(player_image),
                                    (width, height))
        self.speed = player_speed
        self.rect = self.image.get_rect()
        self.rect.x = player_x
        self.rect.y = player_y

    def reset(self):
        window.blit(self.image, (self.rect.x, self.rect.y))

class Player(GameSprite):
    def update_l(self):
        keys = key.get_pressed()
        if keys[K_w] and self.rect.y > 5:
            self.rect.y -= self.speed
        if keys[K_s] and self.rect.y < win_height - self.rect.height - 5:
            self.rect.y += self.speed

    def update_bot(self, ball):
        if self.rect.centery < ball.rect.centery:
            if self.rect.y < win_height - self.rect.height - 5:
                self.rect.y += self.speed
        if self.rect.centery > ball.rect.centery:
            if self.rect.y > 5:
                self.rect.y -= self.speed

back = (200, 255, 255)
win_width = 600
win_height = 500
window = display.set_mode((win_width, win_height))
display.set_caption("Ping-Pong")

game = True
finish = False
clock = time.Clock()
FPS = 60
score1 = 0
score2 = 0
win_score = 5
speed_x = 3
speed_y = 3

racket1 = Player('racket.png', 30, 200, 4, 50, 150)
racket2 = Player('racket.png', 520, 200, 3, 50, 150)
ball = GameSprite('tenis_ball.png', 275, 225, 4, 50, 50)

font.init()
font_main = font.Font(None, 35)
from pygame import *

class GameSprite(sprite.Sprite):
    def __init__(self, player_image, player_x, player_y,
                player_speed, width, height):
        super().__init__()
        self.image = transform.scale(image.load(player_image),
                                    (width, height))
        self.speed = player_speed
        self.rect = self.image.get_rect()
        self.rect.x = player_x
        self.rect.y = player_y

    def reset(self):
        window.blit(self.image, (self.rect.x, self.rect.y))

class Player(GameSprite):
    def update_l(self):
        keys = key.get_pressed()
        if keys[K_w] and self.rect.y > 5:
            self.rect.y -= self.speed
        if keys[K_s] and self.rect.y < win_height - self.rect.height - 5:
            self.rect.y += self.speed

    def update_bot(self, ball):
        if self.rect.centery < ball.rect.centery:
            if self.rect.y < win_height - self.rect.height - 5:
                self.rect.y += self.speed
        if self.rect.centery > ball.rect.centery:
            if self.rect.y > 5:
                self.rect.y -= self.speed

back = (200, 255, 255)
win_width = 600
win_height = 500
window = display.set_mode((win_width, win_height))
display.set_caption("Ping-Pong")

game = True
finish = False
clock = time.Clock()
FPS = 60
score1 = 0
score2 = 0
win_score = 5
speed_x = 3
speed_y = 3

racket1 = Player('racket.png', 30, 200, 4, 50, 150)
racket2 = Player('racket.png', 520, 200, 3, 50, 150)
ball = GameSprite('tenis_ball.png', 275, 225, 4, 50, 50)

font.init()
font_main = font.Font(None, 35)
font_big = font.Font(None, 50)
player1_win = font_big.render('PLAYER 1 WIN!', True, (180, 0, 0))
player2_win = font_big.render('PLAYER 2 WIN!', True, (180, 0, 0))
restart_text = font_main.render("Нажми R, чтобы начать заново", True, (0, 0, 0))

def reset_ball(direction):
    global speed_x, speed_y
    ball.rect.x = win_width // 2 - ball.rect.width // 2
    ball.rect.y = win_height // 2 - ball.rect.height // 2
    speed_x = 3 * direction
    speed_y = 3

def restart_game():
    global score1, score2, finish
    score1 = 0
    score2 = 0
    finish = False
    racket1.rect.x = 30
    racket1.rect.y = 200
    racket2.rect.x = 520
    racket2.rect.y = 200
    reset_ball(1)

while game:
    for e in event.get():
        if e.type == QUIT:
            game = False
        if e.type == KEYDOWN and e.key == K_r:
            restart_game()

    window.fill(back)

    if not finish:
        racket1.update_l()
        racket2.update_bot(ball)
        ball.rect.x += speed_x
        ball.rect.y += speed_y

        if ball.rect.y > win_height - ball.rect.height or ball.rect.y < 0:
            speed_y *= -1
        if sprite.collide_rect(racket1, ball) and speed_x < 0:
            speed_x *= -1
        if sprite.collide_rect(racket2, ball) and speed_x > 0:
            speed_x *= -1

        if ball.rect.x < 0:
            score2 += 1
            if score2 >= win_score:
                finish = True
            else:
                reset_ball(1)
        if ball.rect.x > win_width:
            score1 += 1
            if score1 >= win_score:
                finish = True
            else:
                reset_ball(-1)

    racket1.reset()
    racket2.reset()
    ball.reset()

    score_text = font_main.render(str(score1) + " : " + str(score2),
                                  True, (0, 0, 0))
    window.blit(score_text, (270, 20))

    if finish:
        if score1 >= win_score:
            window.blit(player1_win, (160, 200))
        if score2 >= win_score:
            window.blit(player2_win, (160, 200))
        window.blit(restart_text, (140, 270))

    display.update()
    clock.tick(FPS)